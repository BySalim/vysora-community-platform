{
  "name": "vysora-community-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Vysora : voir comment l'IA crée, apprendre à créer avec elle.",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @vysora/shared build && pnpm --parallel --filter @vysora/shared --filter @vysora/api --filter @vysora/web run dev",
    "dev:api": "pnpm --filter @vysora/shared build && pnpm --filter @vysora/api run dev",
    "dev:web": "pnpm --filter @vysora/web run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter @vysora/shared build && pnpm -r run typecheck",
    "lint": "oxlint apps/api/src apps/api/test apps/web/src packages/shared/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @vysora/shared build && pnpm -r run test",
    "test:e2e": "pnpm --filter @vysora/shared build && pnpm --filter @vysora/api run test:e2e",
    "verifier": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @vysora/api run db:generate",
    "db:migrate": "pnpm --filter @vysora/api run db:migrate",
    "db:seed": "pnpm --filter @vysora/shared build && pnpm --filter @vysora/api run db:seed",
    "db:reset": "pnpm --filter @vysora/shared build && pnpm --filter @vysora/api run db:reset",
    "db:studio": "pnpm --filter @vysora/api run db:studio",
    "prototype": "node scripts/serveur-prototype.mjs --port 5173"
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "~6.0.3"
  }
}
