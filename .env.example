# Copier ce fichier en .env à la racine du dépôt : cp .env.example .env
# Les valeurs ci-dessous conviennent au développement local (docker compose). En production,
# chaque secret est généré et stocké hors du dépôt.

NODE_ENV=development
LOG_LEVEL=debug

# Adresse publique du site (liens des e-mails, contrôle de l'origine des requêtes)
SITE_URL=http://localhost:4321
# Origines autorisées à appeler l'API avec le cookie de session (séparées par des virgules)
ORIGINES_AUTORISEES=http://localhost:4321

# API
API_PORT=3000
# Adresse de l'API vue depuis le serveur web (rendu côté serveur)
API_URL_INTERNE=http://localhost:3000

# Base de données (docker compose)
DATABASE_URL=postgres://vysora:vysora@localhost:5432/vysora
DATABASE_URL_TEST=postgres://vysora:vysora@localhost:5432/vysora_test

# E-mails : Mailpit capture tout en local (interface sur http://localhost:8025)
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_EXPEDITEUR="Vysora <ne-pas-repondre@vysora.local>"
EMAIL_EQUIPE=equipe@vysora.local

# Secrets : en production, générer chaque valeur avec
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Sel des empreintes d'adresses IP (anti-abus sans conserver l'adresse en clair)
SEL_EMPREINTES=dev-sel-a-remplacer-en-production
# Clé de chiffrement des données sensibles stockées (e-mails en attente dans la file, double
# authentification), 32 octets en base64url. La changer rend illisibles les e-mails encore en file.
CLE_CHIFFREMENT=dnlzb3JhLWRldi1jbGUtMzItb2N0ZXRzLWV4YWN0ZSE

# Fichiers téléversés (images) : dossier local, relatif au dossier de lancement de l'API
# (apps/api/stockage en développement). En production : un chemin absolu, sur un volume sauvegardé.
STOCKAGE_DOSSIER=./stockage

# Mots de passe : refus de ceux qui figurent dans des fuites connues (Have I Been Pwned).
# Seuls les 5 premiers caractères de l'empreinte SHA-1 sont envoyés (k-anonymat).
VERIFIER_FUITES=true

# Bêta fermée (INV-01) : l'inscription exige un code d'invitation (pnpm invitations:creer).
# À mettre à true en préproduction et en production pendant la bêta.
INSCRIPTION_SUR_INVITATION=false

# Connexion avec GitHub et Google (S-10, docs/deploiement.md) : identifiants de vos applications
# OAuth de développement. Vides, le service reste fermé et son bouton le dit. Adresses de retour à
# déclarer : http://localhost:4321/api/v1/auth/github/retour et …/google/retour.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
