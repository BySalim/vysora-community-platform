{
  "name": "@vysora/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de Vysora (NestJS) : seule porte d'accès aux données et seule autorité sur les règles de gestion.",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "start:migrate": "node dist/db/migrer.js",
    "start:seed": "node dist/db/seed/index.js",
    "start:demo": "node dist/db/demo/index.js",
    "start:nettoyer-medias": "node dist/taches/nettoyer-medias.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrer.ts",
    "db:seed": "tsx src/db/seed/index.ts",
    "invitations:creer": "tsx src/db/invitations.ts",
    "db:demo": "tsx src/db/demo/index.ts",
    "db:reset": "tsx src/db/reinitialiser.ts",
    "medias:nettoyer": "tsx src/taches/nettoyer-medias.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@vysora/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.1",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
