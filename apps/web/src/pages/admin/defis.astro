---
/* Gestion des défis (S-07, EC-24, F-63, F-65 ; S-17 : démo validée le 2026-11-16,
   prototype/administration-defis.*). La liste des défis par état (filtres, « À faire »), puis la
   fiche d'un défi (#defi-<id>) en trois onglets : le contenu (formulaire et aperçu de la page
   Défis), les participations et la clôture. Actions : créer, dupliquer, modifier (dates comprises),
   publier, ouvrir maintenant, mettre en pause et reprendre, clôturer (dès le début), annuler,
   rétablir, supprimer un brouillon. Rendu et envois : scripts/administration-defis.ts. */
import { raisonRefus, type DefiAdministreApi } from '@vysora/shared';
import AccesBloc from '../../components/AccesBloc.astro';
import OngletsAdministration from '../../components/OngletsAdministration.astro';
import Base from '../../layouts/Base.astro';
import { appelerApi } from '../../lib/api';
import { pluriel } from '../../lib/texte';
import '../../styles/moderation.css';
import '../../styles/moderation-complements.css';
import '../../styles/defis.css';
import '../../styles/defis-complements.css';
import '../../styles/administration-defis.css';

const raison = raisonRefus('administrer', Astro.locals.etat);
if (raison === 'role') Astro.response.status = 403;
const defis = raison
  ? null
  : await appelerApi<DefiAdministreApi[]>('/api/v1/admin/defis', { requete: Astro.request });
---

<Base
  titre="Défis · Administration"
  description="Création, publication, suivi des participations et clôture des défis de Vysora."
  classeCorps="md"
  icones={[
    'plus',
    'trophy',
    'arrow-up-right',
    'chevron-right',
    'shield',
    'lock',
    'pause',
    'play',
    'info',
    'clock',
    'podium',
    'check-circle',
    'pen',
    'close',
    'eye',
    'bulb',
    'award',
    'alert',
    'utile',
    'user',
    'keyboard',
    'smile',
    'trend-up',
    'image',
    'globe',
    'grid',
    'route',
    'code',
    'repeat',
  ]}
  nonIndexee
>
  <div class="container md-tete" data-adf-tete-liste>
    <p class="md-rubrique">
      <svg class="icon icon-sm" aria-hidden="true">
        <use href="#i-shield"></use>
      </svg>
      Administration
    </p>
    <h1>Défis</h1>
    {defis && (
      <p class="md-statut" data-adf-statut>
        <span class="is-fort">{pluriel(defis.length, 'défi', 'défis')}</span>
      </p>
    )}
    {!raison && <OngletsAdministration actif="defis" />}
  </div>

  {raison ? (
    <div class="container md-acces">
      <AccesBloc action="administrer" quoi="gérer les défis" />
    </div>
  ) : (
    <div data-adf-page />
  )}

  <Fragment slot="fin">
    {defis && (
      <>
        <dialog
          class="md-dialogue"
          aria-labelledby="ad-dialogue-titre"
          aria-describedby="ad-dialogue-texte"
          data-ad-dialogue
        >
          <form method="dialog">
            <h2 id="ad-dialogue-titre" data-ad-dialogue-titre />
            <p id="ad-dialogue-texte" data-ad-dialogue-texte />
            <div class="md-dialogue-actions">
              <button class="btn btn-secondary" type="submit" value="annuler">
                Revenir
              </button>
              <button class="btn btn-primary" type="button" data-ad-confirmer>
                Confirmer
              </button>
            </div>
          </form>
        </dialog>
        <script type="application/json" id="adf-donnees" set:html={JSON.stringify(defis)} />
      </>
    )}
  </Fragment>
</Base>

<script>
  import '../../scripts/administration-defis';
</script>
