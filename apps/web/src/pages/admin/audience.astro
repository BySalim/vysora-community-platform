---
/* Audience (LEG-03) : fréquentation du site, problèmes techniques et parcours des visites suivies
   avec l'accord des personnes. Écran sans maquette dans le prototype, dans le style des écrans
   d'administration et de « Assistants d'IA » : période en tête, quatre chiffres, courbe par jour,
   puis le détail. Rendu par le serveur depuis GET /api/v1/admin/audience. */
import {
  AUDIENCE,
  DELAIS,
  LIBELLES_APPAREIL,
  LIBELLES_EVENEMENT_PARCOURS,
  LIBELLES_NAVIGATEUR,
  LIBELLES_SYSTEME,
  PERIODES_MESURE_ASSISTANTS,
  libelleProvenance,
  raisonRefus,
  type EtapeVisiteApi,
  type LigneMesureAudience,
  type MesureAudienceApi,
} from '@vysora/shared';
import AccesBloc from '../../components/AccesBloc.astro';
import OngletsAdministration from '../../components/OngletsAdministration.astro';
import Base from '../../layouts/Base.astro';
import { appelerApi } from '../../lib/api';
import { ROUTES } from '../../lib/navigation';
import { dateCourte, dateLongue, fmt, jourEtHeure, pluriel, typo } from '../../lib/texte';
import '../../styles/moderation.css';
import '../../styles/moderation-complements.css';

let adresseClient: string | undefined;
try {
  adresseClient = Astro.clientAddress;
} catch {
  adresseClient = undefined;
}

const raison = raisonRefus('administrer', Astro.locals.etat);
if (raison === 'role') Astro.response.status = 403;
const demandee = Number(Astro.url.searchParams.get('jours'));
const jours = (PERIODES_MESURE_ASSISTANTS as readonly number[]).includes(demandee) ? demandee : 30;
const mesure = raison
  ? null
  : await appelerApi<MesureAudienceApi>(`/api/v1/admin/audience?jours=${jours}`, {
      requete: Astro.request,
      adresseClient,
    });

const CHIFFRES = mesure
  ? [
      {
        valeur: mesure.chiffres.visiteurs,
        nom: 'Visiteurs',
        aide: 'Personnes différentes chaque jour, additionnées : qui revient trois jours compte trois fois.',
      },
      {
        valeur: mesure.chiffres.visites,
        nom: 'Arrivées',
        aide: 'Visites venues d’un autre site, d’un lien direct ou d’une campagne.',
      },
      {
        valeur: mesure.chiffres.pagesVues,
        nom: 'Pages vues',
        aide: 'Pages servies aux personnes, hors robots et pages de l’équipe.',
      },
      {
        valeur: mesure.chiffres.problemes,
        nom: 'Problèmes',
        aide: 'Pages introuvables ou en erreur, erreurs de l’API et des scripts.',
      },
    ]
  : [];

const maxVisiteurs = mesure ? Math.max(1, ...mesure.parJour.map((p) => p.visiteurs)) : 1;
const part = (n: number, total: number) => {
  if (!total) return '–';
  const pourcent = Math.round((n / total) * 100);
  return n > 0 && pourcent === 0 ? '< 1 %' : `${pourcent} %`;
};
const duree = (secondes: number) => {
  if (secondes < 60) return `${secondes} s`;
  const minutes = Math.floor(secondes / 60);
  if (minutes < 60) return `${minutes} min ${String(secondes % 60).padStart(2, '0')} s`;
  return `${Math.floor(minutes / 60)} h ${String(minutes % 60).padStart(2, '0')} min`;
};
const repartitions = mesure
  ? [
      {
        titre: 'Appareils',
        lignes: mesure.appareils.map((a) => ({ nom: LIBELLES_APPAREIL[a.code], nombre: a.nombre })),
      },
      {
        titre: 'Navigateurs',
        lignes: mesure.navigateurs.map((a) => ({
          nom: LIBELLES_NAVIGATEUR[a.code],
          nombre: a.nombre,
        })),
      },
      {
        titre: 'Systèmes',
        lignes: mesure.systemes.map((a) => ({ nom: LIBELLES_SYSTEME[a.code], nombre: a.nombre })),
      },
    ]
  : [];
const problemes: {
  titre: string;
  colonne: string;
  lignes: LigneMesureAudience[];
  code?: boolean;
}[] = mesure
  ? [
      { titre: 'Pages introuvables', colonne: 'Page', lignes: mesure.problemes.introuvables },
      { titre: 'Pages en erreur', colonne: 'Page', lignes: mesure.problemes.erreursPages },
      {
        titre: 'Erreurs de l’API',
        colonne: 'Route',
        lignes: mesure.problemes.erreursApi,
        code: true,
      },
    ]
  : [];
const aucunProbleme =
  mesure !== null &&
  problemes.every((p) => !p.lignes.length) &&
  !mesure.problemes.erreursNavigateur.length;
const parcours = mesure?.parcours;
const etape = (e: EtapeVisiteApi) =>
  e.nature === 'PAGE'
    ? { nature: 'Page', texte: e.valeur, detail: '' }
    : e.nature === 'EVENEMENT'
      ? {
          nature: 'Action',
          texte:
            LIBELLES_EVENEMENT_PARCOURS[e.valeur as keyof typeof LIBELLES_EVENEMENT_PARCOURS] ??
            e.valeur,
          detail: '',
        }
      : {
          nature: 'Erreur',
          texte: e.valeur,
          detail:
            e.detail === '404'
              ? 'Page introuvable (404)'
              : e.detail === '500'
                ? 'Erreur du serveur (500)'
                : e.detail,
        };
---

<Base
  titre="Audience"
  description="Fréquentation de Vysora, problèmes techniques et parcours des visites."
  classeCorps="md"
  icones={['shield']}
  nonIndexee
>
  <div class="container md-tete">
    <p class="md-rubrique">
      <svg class="icon icon-sm" aria-hidden="true">
        <use href="#i-shield"></use>
      </svg>
      Administration
    </p>
    <h1>Audience</h1>
    {mesure && (
      <p class="md-statut">
        <span class="is-fort">
          {mesure.chiffres.visiteurs
            ? pluriel(mesure.chiffres.visiteurs, 'visiteur', 'visiteurs')
            : 'Aucun visiteur'}
          {` du ${dateLongue(mesure.du)} au ${dateLongue(mesure.au)}`}
        </span>
        <span>
          {typo(
            'Fréquentation du site, problèmes techniques et parcours des visites suivies avec l’accord des personnes.',
          )}
        </span>
      </p>
    )}
    {!raison && <OngletsAdministration actif="audience" />}
  </div>

  {raison ? (
    <div class="container md-acces">
      <AccesBloc action="administrer" quoi="consulter la mesure d’audience" />
    </div>
  ) : (
    mesure &&
    parcours && (
      <div class="container md-file">
        <nav class="ad-sous-onglets" aria-label="Période">
          {PERIODES_MESURE_ASSISTANTS.map((n) => (
            <a
              href={`${ROUTES.audienceAdmin}?jours=${n}`}
              aria-current={n === jours ? 'page' : undefined}
            >
              {`${n} derniers jours`}
            </a>
          ))}
        </nav>

        <ul class="ad-chiffres">
          {CHIFFRES.map(({ valeur, nom, aide }) => (
            <li class="ad-chiffre">
              <b>{fmt(valeur)}</b>
              <span class="ad-chiffre-nom">{nom}</span>
              <span class="ad-chiffre-aide">{typo(aide)}</span>
            </li>
          ))}
        </ul>

        <section class="ad-famille" aria-labelledby="ad-jours-titre">
          <h2 id="ad-jours-titre">Visiteurs par jour</h2>
          <ol class="ad-courbe" style={`--n: ${mesure.parJour.length}`}>
            {mesure.parJour.map((point) => (
              <li
                class="ad-courbe-jour"
                tabindex="0"
                data-info={typo(
                  `${dateCourte(point.jour)} · ${pluriel(point.visiteurs, 'visiteur', 'visiteurs')} · ${pluriel(point.pagesVues, 'page vue', 'pages vues')}`,
                )}
              >
                <span
                  class="ad-courbe-barre"
                  style={`--h: ${(point.visiteurs / maxVisiteurs) * 100}%`}
                  aria-hidden="true"
                />
                <span class="sr-only">
                  {typo(
                    `${dateLongue(point.jour)} : ${pluriel(point.visiteurs, 'visiteur', 'visiteurs')}, ${pluriel(point.pagesVues, 'page vue', 'pages vues')}`,
                  )}
                </span>
              </li>
            ))}
          </ol>
          <p class="ad-courbe-axe" aria-hidden="true">
            <span>{dateCourte(mesure.du)}</span>
            <span>{`Au plus ${pluriel(maxVisiteurs, 'visiteur', 'visiteurs')} par jour`}</span>
            <span>{dateCourte(mesure.au)}</span>
          </p>
        </section>

        {mesure.pages.length ? (
          <>
            <section class="ad-famille" aria-labelledby="ad-pages-titre">
              <h2 id="ad-pages-titre">
                Pages les plus vues
                <span class="ad-famille-nb">{fmt(mesure.pages.length)}</span>
              </h2>
              <table class="ad-table ad-mesure">
                <thead>
                  <tr>
                    <th scope="col">Page</th>
                    <th scope="col">Pages vues</th>
                    <th scope="col">Part</th>
                  </tr>
                </thead>
                <tbody>
                  {mesure.pages.map((p) => (
                    <tr>
                      <td>
                        <a class="ad-lien" href={p.valeur}>
                          <code>{p.valeur}</code>
                        </a>
                      </td>
                      <td data-libelle="Pages vues">{fmt(p.nombre)}</td>
                      <td data-libelle="Part">{part(p.nombre, mesure.chiffres.pagesVues)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>

            <div class="ad-colonnes">
              <section class="ad-famille" aria-labelledby="ad-provenances-titre">
                <h2 id="ad-provenances-titre">Provenance des arrivées</h2>
                <table class="ad-table ad-mesure">
                  <thead>
                    <tr>
                      <th scope="col">Provenance</th>
                      <th scope="col">Arrivées</th>
                      <th scope="col">Part</th>
                    </tr>
                  </thead>
                  <tbody>
                    {mesure.provenances.map((p) => (
                      <tr>
                        <td>{typo(libelleProvenance(p.valeur))}</td>
                        <td data-libelle="Arrivées">{fmt(p.nombre)}</td>
                        <td data-libelle="Part">{part(p.nombre, mesure.chiffres.visites)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </section>

              <section class="ad-famille" aria-labelledby="ad-appareils-titre">
                <h2 id="ad-appareils-titre">Appareils des visiteurs</h2>
                {repartitions.map((repartition) => (
                  <table class="ad-table ad-mesure ad-repartition">
                    <thead>
                      <tr>
                        <th scope="col">{repartition.titre}</th>
                        <th scope="col">Visiteurs</th>
                        <th scope="col">Part</th>
                      </tr>
                    </thead>
                    <tbody>
                      {repartition.lignes.map((ligne) => (
                        <tr>
                          <td>{typo(ligne.nom)}</td>
                          <td data-libelle="Visiteurs">{fmt(ligne.nombre)}</td>
                          <td data-libelle="Part">
                            {part(
                              ligne.nombre,
                              repartition.lignes.reduce((s, l) => s + l.nombre, 0),
                            )}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ))}
              </section>
            </div>
          </>
        ) : (
          <p class="md-rien ad-vide">{typo('Aucune page vue pendant cette période.')}</p>
        )}

        <section class="ad-famille" aria-labelledby="ad-problemes-titre">
          <h2 id="ad-problemes-titre">
            Problèmes techniques
            <span class="ad-famille-nb">{fmt(mesure.chiffres.problemes)}</span>
          </h2>
          {aucunProbleme ? (
            <p class="md-rien ad-vide">{typo('Aucun problème relevé pendant cette période.')}</p>
          ) : (
            <div class="ad-colonnes">
              {problemes
                .filter((p) => p.lignes.length)
                .map((p) => (
                  <table class="ad-table ad-mesure">
                    <thead>
                      <tr>
                        <th scope="col">{typo(p.titre)}</th>
                        <th scope="col">Nombre</th>
                      </tr>
                    </thead>
                    <tbody>
                      {p.lignes.map((ligne) => (
                        <tr>
                          <td>
                            <code>{ligne.valeur}</code>
                          </td>
                          <td data-libelle="Nombre">{fmt(ligne.nombre)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ))}
              {mesure.problemes.erreursNavigateur.length > 0 && (
                <table class="ad-table ad-mesure ad-colonne-large">
                  <thead>
                    <tr>
                      <th scope="col">Erreurs des scripts</th>
                      <th scope="col">Nombre</th>
                    </tr>
                  </thead>
                  <tbody>
                    {mesure.problemes.erreursNavigateur.map((erreur) => (
                      <tr>
                        <td>
                          <code>{erreur.page}</code>
                          <span class="ad-message">{erreur.message}</span>
                        </td>
                        <td data-libelle="Nombre">{fmt(erreur.nombre)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
            </div>
          )}
        </section>

        <section class="ad-famille" aria-labelledby="ad-parcours-titre">
          <h2 id="ad-parcours-titre">
            Parcours des visites suivies
            <span class="ad-famille-nb">{fmt(parcours.visites)}</span>
          </h2>
          <p class="ad-famille-aide">
            {typo(
              'Seulement les visites des personnes qui ont accepté le suivi des parcours : un échantillon, jamais relié à un compte.',
            )}
          </p>
          {parcours.visites ? (
            <>
              <ul class="ad-chiffres">
                <li class="ad-chiffre">
                  <b>{fmt(parcours.visites)}</b>
                  <span class="ad-chiffre-nom">Visites suivies</span>
                  <span class="ad-chiffre-aide">
                    {typo(
                      `${part(parcours.visites, mesure.chiffres.visites)} des arrivées de la période.`,
                    )}
                  </span>
                </li>
                <li class="ad-chiffre">
                  <b>{fmt(parcours.pagesParVisite)}</b>
                  <span class="ad-chiffre-nom">Pages par visite</span>
                  <span class="ad-chiffre-aide">En moyenne.</span>
                </li>
                <li class="ad-chiffre">
                  <b>{duree(parcours.dureeMedianeSecondes)}</b>
                  <span class="ad-chiffre-nom">Durée médiane</span>
                  <span class="ad-chiffre-aide">
                    {typo('De la première à la dernière étape d’une visite.')}
                  </span>
                </li>
                <li class="ad-chiffre">
                  <b>
                    {`${fmt(parcours.inscription.visitesInscrites)} / ${fmt(parcours.inscription.visitesPageInscription)}`}
                  </b>
                  <span class="ad-chiffre-nom">Inscriptions</span>
                  <span class="ad-chiffre-aide">
                    {typo(
                      'Visites avec une inscription, sur les visites passées par la page Inscription.',
                    )}
                  </span>
                </li>
              </ul>

              <div class="ad-colonnes">
                {[
                  { titre: 'Pages d’entrée', lignes: parcours.entrees },
                  { titre: 'Pages de sortie', lignes: parcours.sorties },
                ].map((liste) => (
                  <table class="ad-table ad-mesure">
                    <thead>
                      <tr>
                        <th scope="col">{typo(liste.titre)}</th>
                        <th scope="col">Visites</th>
                      </tr>
                    </thead>
                    <tbody>
                      {liste.lignes.map((ligne) => (
                        <tr>
                          <td>
                            <code>{ligne.valeur}</code>
                          </td>
                          <td data-libelle="Visites">{fmt(ligne.nombre)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ))}
                {parcours.enchainements.length > 0 && (
                  <table class="ad-table ad-mesure">
                    <thead>
                      <tr>
                        <th scope="col">Enchaînements fréquents</th>
                        <th scope="col">Fois</th>
                      </tr>
                    </thead>
                    <tbody>
                      {parcours.enchainements.map((suite) => (
                        <tr>
                          <td>
                            <code>{suite.de}</code>
                            <span class="ad-fleche" aria-label="puis">
                              →
                            </span>
                            <code>{suite.vers}</code>
                          </td>
                          <td data-libelle="Fois">{fmt(suite.nombre)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
                {parcours.evenements.length > 0 && (
                  <table class="ad-table ad-mesure">
                    <thead>
                      <tr>
                        <th scope="col">Actions</th>
                        <th scope="col">Visites</th>
                      </tr>
                    </thead>
                    <tbody>
                      {parcours.evenements.map((evenement) => (
                        <tr>
                          <td>{typo(LIBELLES_EVENEMENT_PARCOURS[evenement.code])}</td>
                          <td data-libelle="Visites">{fmt(evenement.visites)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
              </div>

              <h3 class="ad-sous-titre">Dernières visites avec une erreur</h3>
              {parcours.avecErreur.length ? (
                <ol class="ad-visites">
                  {parcours.avecErreur.map((visite) => (
                    <li class="ad-visite">
                      <p class="ad-visite-tete">
                        <b>{typo(jourEtHeure(visite.debut))}</b>
                        <span>
                          {typo(
                            `${libelleProvenance(visite.provenance)} · ${LIBELLES_APPAREIL[visite.appareil]}, ${LIBELLES_NAVIGATEUR[visite.navigateur]}, ${LIBELLES_SYSTEME[visite.systeme]}`,
                          )}
                        </span>
                      </p>
                      <ol class="ad-etapes">
                        {visite.etapes.map((e) => {
                          const vue = etape(e);
                          return (
                            <li class:list={['ad-etape', { 'is-erreur': e.nature === 'ERREUR' }]}>
                              <span class="ad-etape-temps">{duree(e.secondes)}</span>
                              <span class="ad-etape-nature">{vue.nature}</span>
                              <span class="ad-etape-texte">
                                {e.nature === 'EVENEMENT' ? (
                                  typo(vue.texte)
                                ) : (
                                  <code>{vue.texte}</code>
                                )}
                                {vue.detail && <span class="ad-message">{vue.detail}</span>}
                              </span>
                            </li>
                          );
                        })}
                      </ol>
                    </li>
                  ))}
                </ol>
              ) : (
                <p class="md-rien ad-vide">
                  {typo('Aucune visite suivie n’a rencontré d’erreur pendant cette période.')}
                </p>
              )}
            </>
          ) : (
            <p class="md-rien ad-vide">{typo('Aucune visite suivie pendant cette période.')}</p>
          )}
        </section>

        <p class="ad-mesure-note">
          {typo(
            `Mesure faite par les serveurs de Vysora, sans outil d’un tiers. Les visiteurs ne sont reconnus que le temps d’une journée, par une empreinte effacée au bout de ${DELAIS.conservationVisiteursJours} jours ; les compteurs sont gardés ${DELAIS.conservationAudienceMois} mois. Les personnes qui refusent la mesure ne sont pas comptées. Les parcours, suivis seulement avec l’accord des personnes et jamais reliés à un compte, sont effacés au bout de ${DELAIS.conservationParcoursMois} mois ; une visite s’arrête après ${AUDIENCE.inactiviteParcoursMinutes} minutes sans activité.`,
          )}
        </p>
      </div>
    )
  )}
</Base>
