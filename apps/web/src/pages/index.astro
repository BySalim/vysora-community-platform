---
/* Accueil (ACC-01, EC-01, F-21), porté de prototype/index.html : même balisage et mêmes styles
   (styles.css), réglages du panneau Tweaks figés sur leurs valeurs par défaut. Les zones que le
   prototype remplissait avec data.js viennent de l'API (GET /api/v1/accueil, référentiels) et sont
   rendues par le serveur avec les fonctions de lib/accueil, que le script reprend pour les onglets,
   le fil d'activité et la correction d'un cas. Le constat, la méthode, les profils illustrés, les
   engagements et les questions fréquentes restent les textes du prototype. */
import {
  BAREME_REPUTATION,
  NIVEAUX,
  type AccueilApi,
  type BadgeApi,
  type ReferentielsApi,
} from '@vysora/shared';
import Base from '../layouts/Base.astro';
import { appelerApi } from '../lib/api';
import { domainesHTML, listeHTML } from '../lib/accueil/cartes';
import { courbeHTML, repartitionHTML, tendance, totalSemaine } from '../lib/accueil/courbe';
import type { DonneesAccueil } from '../lib/accueil/donnees';
import { duree } from '../lib/accueil/elements';
import { filHTML } from '../lib/accueil/fil';
import {
  astuceHTML,
  badgesHTML,
  casHTML,
  cliniqueHTML,
  defiHTML,
  emblemesHTML,
  ligneClassement,
  sujetsHTML,
} from '../lib/accueil/laboratoire';
import { ROUTES } from '../lib/navigation';
import { avecLogos } from '../lib/outils-texte';
import { fmt, pluriel, t, typo } from '../lib/texte';
import '../styles/accueil-complements.css';

let adresseClient: string | undefined;
try {
  adresseClient = Astro.clientAddress;
} catch {
  adresseClient = undefined;
}
const options = { requete: Astro.request, adresseClient };
const [accueil, referentiels] = await Promise.all([
  appelerApi<AccueilApi>('/api/v1/accueil', options).catch(() => null),
  appelerApi<ReferentielsApi>('/api/v1/referentiels', options).catch(() => null),
]);
const maintenant = accueil ? new Date(accueil.maintenant) : new Date();

const outils = referentiels?.outils ?? [];
const logos = avecLogos(outils);
const creations = accueil?.creations ?? { utiles: [], recentes: [], reproduites: [], exemples: {} };
const exemples = creations.exemples;
const chiffres = accueil?.chiffres ?? { creations: 0, reproductions: 0, questionsResolues: 0 };
const activite = accueil?.activite ?? [];
const apprentissage = accueil?.apprentissage ?? {
  debut: maintenant.toISOString().slice(0, 10),
  parJour: [0],
  semaine: { votes: 0, reproductions: 0, casReussis: 0, reponsesAcceptees: 0 },
};
const evolution = tendance(apprentissage);
const enAttente = accueil?.enAttente ?? [];
const astuce = accueil?.astuce ?? null;
const classement = accueil?.classement ?? [];
const niveaux = referentiels?.niveaux.length ? referentiels.niveaux : NIVEAUX;

/** Badges présentés par « Progresser » et par le profil illustré (prototype : data.js, badges). */
const BADGES_ACCUEIL = [
  'PIONNIER',
  'PREMIERE_CREATION',
  'PARCOURS_COMPLET',
  'REPRODUCTIBLE',
  'BON_REFLEXE',
  'MENTOR',
  'ASTUCIEUX',
  'PODIUM',
];
const EMBLEMES_PROFIL = ['MENTOR', 'REPRODUCTIBLE', 'PARCOURS_COMPLET'];
const badgesDe = (codes: string[]): BadgeApi[] =>
  codes.flatMap((code) => referentiels?.badges.find((b) => b.code === code) ?? []);

const filVide = `<li class="feed-item feed-vide"><p>${t('Aucune contribution pour l’instant.')}</p></li>`;
const sujetsVides = `<li class="topic topic-vide"><p>${t('Aucune question n’attend de réponse pour l’instant.')}</p></li>`;
const indisponible = `<li class="cards-vide"><p>${t('Les créations ne peuvent pas s’afficher pour le moment. Réessayez dans un instant.')}</p></li>`;
const classementVide = `<li class="board-vide"><p>${t('Aucun point gagné cette semaine pour l’instant.')}</p></li>`;

/* « Apprendre » : un onglet par format qui a de quoi s'afficher. */
const bonReflexe = accueil?.bonReflexe;
const clinique = accueil?.clinique;
const defi = accueil?.defi ?? null;
const onglets = [
  bonReflexe?.cas && {
    cle: 'reflex',
    nom: 'Bon réflexe',
    description: typo(
      'Jugez une vraie réponse d’IA, puis comparez votre décision avec l’analyse d’un expert.',
    ),
    meta: typo(`${pluriel(bonReflexe.reponsesSemaine, 'réponse', 'réponses')} cette semaine`),
    attributs: { 'data-reflex': '' },
    html: casHTML(bonReflexe.cas),
  },
  clinique?.exemple && {
    cle: 'clinic',
    nom: 'Clinique du prompt',
    description: typo(
      'Un prompt qui résiste ? La communauté vous aide à le reformuler, en expliquant chaque changement.',
    ),
    meta:
      clinique.resolutionMoyenneMinutes === null
        ? null
        : typo(`Résolue en ${duree(clinique.resolutionMoyenneMinutes)} en moyenne`),
    attributs: { 'data-clinic': '' },
    html: cliniqueHTML(clinique.exemple),
  },
  defi && {
    cle: 'challenge',
    nom: 'Défi de la semaine',
    description: typo(
      'Une contrainte commune, puis les méthodes de tous les participants à comparer.',
    ),
    meta: typo(pluriel(defi.participations, 'participation', 'participations')),
    attributs: {},
    html: defiHTML(defi),
  },
].filter((o) => Boolean(o)) as {
  cle: string;
  nom: string;
  description: string;
  meta: string | null;
  attributs: Record<string, string>;
  html: string;
}[];

// « < » échappé : aucune valeur ne peut fermer la balise <script> qui porte les données.
const donnees: DonneesAccueil = {
  accueil,
  outils: outils.map((o) => ({
    nom: o.nom,
    logo: o.logo,
    logoMonochrome: o.logoMonochrome,
    famille: o.famille,
  })),
  maintenant: maintenant.toISOString(),
};
const json = JSON.stringify(donnees).replaceAll('<', '\\u003c');

const description =
  'Vysora est la communauté où l’on publie ce que l’on crée avec l’IA avec le chemin parcouru : prompts, outils, modèles et corrections. Reproduisez ce qui fonctionne et apprenez de la communauté.';

/** Réglages du prototype (Tweaks), à leur valeur par défaut. */
const REGLAGES = {
  herolead: 'court',
  herowaves: 'houle',
  herolimit: 'text',
  heroblue: 'deep',
  herobg: 'constellation',
  herosize: 'full',
  band: 'dark',
  cards: 'path',
  eyebrow: 'icon',
  toolsbg: 'trame',
  methodfocus: 'suivi',
};

const ICONES_PAGE = [
  'arrow',
  'arrow-down',
  'arrow-up-right',
  'search',
  'plus',
  'menu',
  'close',
  'check',
  'x',
  'pause',
  'play',
  'chevron-down',
  'chevron-left',
  'chevron-right',
  'copy',
  'utile',
  'repeat',
  'moment',
  'check-circle',
  'layers',
  'bulb',
  'message',
  'award',
  'flag',
  'alert',
  'trophy',
  'route',
  'browser',
  'image',
  'pen',
  'code',
  'flow',
  'chart',
  'film',
  'music',
  'school',
  'shapes',
  'shield',
  'lock',
  'scale',
  'gift',
  'heart',
  'sliders',
  'replay',
  'clock',
  'user',
  'external',
  'mail',
  'folder',
  'scan',
  'trend-up',
  'users',
  'help',
  'globe',
  'type-prompt',
  'type-iteration',
  'type-projet',
  'compass',
  'rotate',
];
---

<Base
  titre="Voir comment l’IA crée"
  description={description}
  classeCorps="accueil"
  reglages={REGLAGES}
  icones={ICONES_PAGE}
>
  <section class="hero" aria-labelledby="hero-title" data-hero-section>
    <canvas class="hero-canvas" data-constellation aria-hidden="true"></canvas>
    <canvas class="hero-vagues" data-hero-vagues aria-hidden="true"></canvas>
    <div class="container hero-inner">
      <h1 id="hero-title" class="hero-title" data-vague-apres="title">
        <span class="line">
          <span>Voir comment l’IA crée.</span>
        </span>
        <span class="line line-accent">
          <span>Apprendre à créer avec elle.</span>
        </span>
      </h1>
      <span class="hero-respiration" data-respiration="title" aria-hidden="true"></span>
      <p class="hero-lead" data-vague-apres="text" data-vague-avant="title" data-enter="2">
        Vysora est la communauté où l’on publie ce que l’on crée avec l’IA. Pour reproduire ce qui
        fonctionne, et comprendre pourquoi.
      </p>
      <span class="hero-respiration" data-respiration="text" aria-hidden="true"></span>
      <form
        class="intent"
        action={ROUTES.explorer}
        method="get"
        role="search"
        data-vague-avant="text"
        data-vague-apres="search"
        data-enter="3"
      >
        <label class="intent-label" for="intent-input">
          Que voulez-vous créer ?
        </label>
        <div class="intent-field">
          <svg class="icon" aria-hidden="true">
            <use href="#i-search" />
          </svg>
          <input
            id="intent-input"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="un site de réservation"
            data-intent
          />
          <button class="btn btn-primary" type="submit" data-magnetic>
            Explorer
            <svg class="icon" aria-hidden="true">
              <use href="#i-arrow" />
            </svg>
          </button>
        </div>
      </form>
      <span class="hero-respiration" data-respiration="search" aria-hidden="true"></span>
    </div>
  </section>

  <section class="section tools" id="outils" aria-labelledby="tools-title" data-outils>
    <canvas class="tools-trame" data-tools-trame aria-hidden="true"></canvas>
    <div class="container tools-grid">
      <div class="tools-copy" data-reveal>
        <p class="kicker">
          <svg class="icon" aria-hidden="true">
            <use href="#i-globe" />
          </svg>
          Les outils
        </p>
        <h2 id="tools-title" class="section-title">
          Tous les outils sont les bienvenus.
        </h2>
        <p class="section-lead">
          Publiez avec l’outil que vous utilisez déjà : assistant, générateur d’images, éditeur de
          code ou automatisation. Chacun a la même place sur Vysora, et une création se distingue
          par sa méthode, pas par son outil.
        </p>
        <p class="tools-hint" aria-hidden="true">
          <svg class="icon icon-sm">
            <use href="#i-rotate" />
          </svg>
          Faites tourner la sphère pour parcourir les {fmt(outils.length)} outils référencés.
        </p>
      </div>
      <div class="sphere" data-sphere aria-hidden="true">
        <canvas class="sphere-canvas" data-sphere-canvas></canvas>
        <div class="sphere-items" data-sphere-items></div>
      </div>
    </div>
    <ul class="sr-only" id="tools-list" aria-label="Outils référencés" data-tools-list>
      {outils.map((o) => (
        <li data-family={o.famille.toLowerCase()}>{o.nom}</li>
      ))}
    </ul>
  </section>

  <section class="section" id="constat" aria-labelledby="constat-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="kicker">
          <svg class="icon" aria-hidden="true">
            <use href="#i-scan" />
          </svg>
          Le constat
        </p>
        <h2 id="constat-title" class="section-title">
          Le résultat circule. <em>La méthode se perd.</em>
        </h2>
        <p class="section-lead">
          Sur les réseaux, une création impressionnante récolte des milliers de réactions, mais sa
          méthode reste dans l’ombre. Ceux qui tentent de la refaire avancent par essais et erreurs,
          et ce qu’ils découvrent se perd dans les commentaires. Sur Vysora, la méthode est publiée
          avec le résultat, et chaque reproduction la confirme ou la complète.
        </p>
      </div>

      <div class="compare" data-compare data-reveal style="--pos: 50%">
        <div class="compare-pane compare-before">
          <span class="compare-label">Ailleurs</span>
          <ul
            class="compare-notes compare-notes-before"
            aria-label="Ce qui manque sur un réseau social"
          >
            <li>
              <svg class="icon icon-sm" aria-hidden="true">
                <use href="#i-x" />
              </svg>
              Aucun outil ni modèle indiqué
            </li>
            <li>
              <svg class="icon icon-sm" aria-hidden="true">
                <use href="#i-x" />
              </svg>
              Aucun prompt partagé
            </li>
            <li>
              <svg class="icon icon-sm" aria-hidden="true">
                <use href="#i-x" />
              </svg>
              Impossible de savoir si cela fonctionne encore
            </li>
          </ul>
          <article class="post" aria-label="Publication sur un réseau social">
            <header class="post-head">
              <img
                class="avatar"
                src="/assets/avatars/lea-martin.webp"
                alt=""
                width="32"
                height="32"
                loading="lazy"
                decoding="async"
              />
              <span>
                <b>lea.cree</b>
                <small>il y a 3 jours</small>
              </span>
            </header>
            <p class="post-text">Ma nouvelle illustration, faite avec l’IA.</p>
            <div class="post-media">
              <img
                src="/assets/images/cite-imaginaire-720.webp"
                alt=""
                width="720"
                height="540"
                loading="lazy"
                decoding="async"
              />
            </div>
            <p class="post-stats">
              <span>
                <svg class="icon icon-sm" aria-hidden="true">
                  <use href="#i-heart" />
                </svg>
                2,4 k
              </span>
              <span>
                <svg class="icon icon-sm" aria-hidden="true">
                  <use href="#i-message" />
                </svg>
                312 commentaires
              </span>
            </p>
            <ul class="post-comments">
              <li>
                <b>sam_designs</b> Tu as utilisé quel outil ?
              </li>
              <li>
                <b>nadia.k</b> Le prompt, s’il te plaît
              </li>
              <li>
                <b>tom.r</b> Chez moi, ça ne donne pas du tout ça…
              </li>
            </ul>
          </article>
        </div>
        <div class="compare-pane compare-after">
          <span class="compare-label compare-label-after">Sur Vysora</span>
          <article class="sheet-card" aria-label="La même création publiée sur Vysora">
            <header class="post-head">
              <img
                class="avatar"
                src="/assets/avatars/lea-martin.webp"
                alt=""
                width="32"
                height="32"
                loading="lazy"
                decoding="async"
              />
              <span>
                <b>Léa Martin</b>
                <small>Apprenti · publiée le 6 oct. 2026</small>
              </span>
              <span class="type-tag" data-type="prompt">
                <svg class="icon" aria-hidden="true">
                  <use href="#i-type-prompt" />
                </svg>
                1 prompt
              </span>
            </header>
            <p class="post-text post-title">Cité imaginaire entre ciel et mer</p>
            <div class="post-media">
              <img
                src="/assets/images/cite-imaginaire-720.webp"
                alt=""
                width="720"
                height="540"
                loading="lazy"
                decoding="async"
              />
            </div>
            <dl class="sheet-config">
              <div>
                <dt>Outil</dt>
                <dd set:html={logos('ChatGPT')} />
              </div>
              <div>
                <dt>Modèle</dt>
                <dd>GPT Image 1</dd>
              </div>
              <div>
                <dt>Essais</dt>
                <dd>Meilleur de 4</dd>
              </div>
            </dl>
            <p class="sheet-prompt">
              Illustration panoramique d’une cité méditerranéenne imaginaire, tours élancées au
              centre, mer bleu cobalt, ciel abricot…
            </p>
            <p class="sheet-moment">
              <svg class="icon icon-sm" aria-hidden="true">
                <use href="#i-moment" />
              </svg>
              <span>
                <b>Découverte</b> « Tours élancées au centre » évite les compositions chargées.
              </span>
            </p>
            <p class="sheet-proof">
              <svg class="icon icon-sm" aria-hidden="true">
                <use href="#i-repeat" />
              </svg>
              44 reproductions · 61 % de succès · dernière le 12 oct.
            </p>
          </article>
          <ul class="compare-notes compare-notes-after" aria-label="Ce que montre Vysora">
            <li>
              <svg class="icon icon-sm" aria-hidden="true">
                <use href="#i-check" />
              </svg>
              Outil, modèle et nombre d’essais
            </li>
            <li>
              <svg class="icon icon-sm" aria-hidden="true">
                <use href="#i-check" />
              </svg>
              Prompt complet, prêt à copier
            </li>
            <li>
              <svg class="icon icon-sm" aria-hidden="true">
                <use href="#i-check" />
              </svg>
              Reproductions déclarées et datées
            </li>
          </ul>
        </div>
        <div class="compare-handle" aria-hidden="true">
          <span>
            <svg class="icon icon-sm">
              <use href="#i-chevron-left" />
            </svg>
            <svg class="icon icon-sm">
              <use href="#i-chevron-right" />
            </svg>
          </span>
        </div>
        <input
          class="compare-range"
          type="range"
          min="0"
          max="100"
          value="50"
          aria-label="Comparer la publication sur un réseau social et la fiche Vysora"
          data-compare-range
        />
      </div>

      <ul class="facts" aria-label="Chiffres sur l’usage de l’IA">
        <li data-reveal style="--stagger:0">
          <p class="fact-value">
            <span data-count="84">84</span> %
          </p>
          <p>
            des développeurs utilisent l’IA ou prévoient de le faire. Ils sont 46 % à se méfier de
            la justesse de ses réponses.
          </p>
          <a
            href="https://www.techrepublic.com/article/news-developer-trust-in-ai-declines/"
            target="_blank"
            rel="noopener"
          >
            Stack Overflow, enquête 2025
            <svg class="icon icon-xs" aria-hidden="true">
              <use href="#i-external" />
            </svg>
          </a>
        </li>
        <li data-reveal style="--stagger:1">
          <p class="fact-value">
            <span data-count="45">45</span> %
          </p>
          <p>
            des tâches testées : le code généré par plus de 100 modèles introduisait une faille de
            sécurité.
          </p>
          <a
            href="https://www.veracode.com/press-release/ai-generated-code-poses-major-security-risks-in-nearly-half-of-all-development-tasks-veracode-research-reveals/"
            target="_blank"
            rel="noopener"
          >
            Veracode, rapport 2025
            <svg class="icon icon-xs" aria-hidden="true">
              <use href="#i-external" />
            </svg>
          </a>
        </li>
        <li data-reveal style="--stagger:2">
          <p class="fact-value">
            <span data-count="17">17</span> %
          </p>
          <p>
            de compréhension en moins chez les développeurs assistés par l’IA dans un essai
            contrôlé. L’écart se réduit quand l’IA sert à comprendre.
          </p>
          <a
            href="https://www.anthropic.com/research/AI-assistance-coding-skills"
            target="_blank"
            rel="noopener"
          >
            Anthropic, étude 2026
            <svg class="icon icon-xs" aria-hidden="true">
              <use href="#i-external" />
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section methode" id="methode" aria-labelledby="method-title">
    <div class="container">
      <div class="section-intro section-intro-split" data-reveal>
        <div>
          <p class="kicker">
            <svg class="icon" aria-hidden="true">
              <use href="#i-layers" />
            </svg>
            La méthode
          </p>
          <h2 id="method-title" class="section-title">
            Chaque création se lit en cinq couches.
          </h2>
        </div>
        <p class="section-lead">
          Toutes les fiches suivent le même ordre : ce qui a été produit, le chemin parcouru pour y
          arriver, puis la preuve que la méthode fonctionne encore.
        </p>
      </div>

      <div class="anatomie" data-anatomie>
        <ol class="anat-etapes">
          <li data-couche="1">
            <span class="anat-num" aria-hidden="true">
              1
            </span>
            <div>
              <h3>Le résultat</h3>
              <p>
                Ce qui a été produit, avec ses liens de démonstration et les limites constatées par
                l’auteur.
              </p>
            </div>
          </li>
          <li data-couche="2">
            <span class="anat-num" aria-hidden="true">
              2
            </span>
            <div>
              <h3>Le parcours</h3>
              <p>
                Les prompts et les réponses dans l’ordre. Un projet se découpe en étapes racontées.
              </p>
            </div>
          </li>
          <li data-couche="3">
            <span class="anat-num" aria-hidden="true">
              3
            </span>
            <div>
              <h3>Les moments clés</h3>
              <p>
                Là où l’auteur a corrigé, refusé ou vérifié. C’est souvent là que se trouve la vraie
                compétence.
              </p>
            </div>
          </li>
          <li data-couche="4">
            <span class="anat-num" aria-hidden="true">
              4
            </span>
            <div>
              <h3>La configuration</h3>
              <p>
                Outil, modèle, paramètres et contexte caché : ce qui influence la réponse sans
                figurer dans le prompt.
              </p>
            </div>
          </li>
          <li data-couche="5">
            <span class="anat-num" aria-hidden="true">
              5
            </span>
            <div>
              <h3>La preuve</h3>
              <p>
                Les reproductions déclarées par la communauté, le taux de succès et la date du
                dernier essai.
              </p>
            </div>
          </li>
        </ol>
        <div class="anat-liens" aria-hidden="true">
          <span data-couche="1"></span>
          <span data-couche="2"></span>
          <span data-couche="3"></span>
          <span data-couche="4"></span>
          <span data-couche="5"></span>
        </div>
        <div class="anat-fiche" aria-hidden="true">
          <div class="anat-tete">
            <span class="type-tag" data-type="iteration">
              <svg class="icon" aria-hidden="true">
                <use href="#i-type-iteration" />
              </svg>
              Itération
            </span>
            <span class="anat-cat">Application web</span>
            <b class="anat-titre">Prise de rendez-vous pour un salon de coiffure</b>
            <span class="anat-auteur">
              <img
                class="avatar"
                src="/assets/avatars/aissatou-ndiaye.webp"
                alt=""
                width="28"
                height="28"
                loading="lazy"
                decoding="async"
              />
