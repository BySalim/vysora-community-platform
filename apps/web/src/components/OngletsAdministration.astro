---
/* Onglets des écrans d'administration (ADM-01, ADM-02, DEC-02, APP-03) : rôles de l'équipe, codes
   d'invitation, défis, guides d'Explorer, savoirs d'Apprendre, référentiels, documents légaux,
   journal des décisions de modération, journal d'audit, audience (LEG-03), assistants d'IA (REF-03). */
import { ROUTES } from '../lib/navigation';

interface Props {
  actif:
    | 'roles'
    | 'invitations'
    | 'defis'
    | 'guides'
    | 'savoirs'
    | 'referentiels'
    | 'documents'
    | 'decisions'
    | 'audit'
    | 'audience'
    | 'assistants';
}

const { actif } = Astro.props;
const ONGLETS = [
  { cle: 'roles', libelle: 'Rôles', href: ROUTES.administration },
  { cle: 'invitations', libelle: 'Invitations', href: ROUTES.invitationsAdmin },
  { cle: 'defis', libelle: 'Défis', href: ROUTES.defisAdmin },
  { cle: 'guides', libelle: 'Guides', href: ROUTES.guidesAdmin },
  { cle: 'savoirs', libelle: 'Savoirs', href: ROUTES.savoirsAdmin },
  { cle: 'referentiels', libelle: 'Référentiels', href: ROUTES.referentielsAdmin },
  { cle: 'documents', libelle: 'Documents légaux', href: ROUTES.documentsLegauxAdmin },
  { cle: 'decisions', libelle: 'Journal des décisions', href: ROUTES.journalDecisions },
  { cle: 'audit', libelle: 'Journal d’audit', href: ROUTES.journalAudit },
  { cle: 'audience', libelle: 'Audience', href: ROUTES.audienceAdmin },
  { cle: 'assistants', libelle: 'Assistants d’IA', href: ROUTES.assistantsIaAdmin },
] as const;
---

<nav class="md-onglets" aria-label="Écrans d’administration">
  {ONGLETS.map((onglet) => (
    <a href={onglet.href} aria-current={onglet.cle === actif ? 'page' : undefined}>
      {onglet.libelle}
    </a>
  ))}
</nav>
