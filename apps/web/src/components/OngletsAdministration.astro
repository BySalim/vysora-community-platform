---
/* Onglets des écrans d'administration (ADM-01, ADM-02) : rôles de l'équipe, codes d'invitation,
   défis, référentiels, documents légaux, journal des décisions de modération, journal d'audit. */
import { ROUTES } from '../lib/navigation';

interface Props {
  actif: 'roles' | 'invitations' | 'defis' | 'referentiels' | 'documents' | 'decisions' | 'audit';
}

const { actif } = Astro.props;
const ONGLETS = [
  { cle: 'roles', libelle: 'Rôles', href: ROUTES.administration },
  { cle: 'invitations', libelle: 'Invitations', href: ROUTES.invitationsAdmin },
  { cle: 'defis', libelle: 'Défis', href: ROUTES.defisAdmin },
  { cle: 'referentiels', libelle: 'Référentiels', href: ROUTES.referentielsAdmin },
  { cle: 'documents', libelle: 'Documents légaux', href: ROUTES.documentsLegauxAdmin },
  { cle: 'decisions', libelle: 'Journal des décisions', href: ROUTES.journalDecisions },
  { cle: 'audit', libelle: 'Journal d’audit', href: ROUTES.journalAudit },
] as const;
---

<nav class="md-onglets" aria-label="Écrans d’administration">
  {ONGLETS.map((onglet) => (
    <a href={onglet.href} aria-current={onglet.cle === actif ? 'page' : undefined}>
      {onglet.libelle}
    </a>
  ))}
</nav>
