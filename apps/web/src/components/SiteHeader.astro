---
/* En-tête commun (prototype : <header class="site-header"> de chaque page, complété par commun.js :
   menu, liens de retour, zone du compte). Rendu côté serveur selon la personne qui consulte. */
import { NIVEAUX } from '@vysora/shared';
import { NAVIGATION, ROUTES, adresseRetour } from '../lib/navigation';
import { fmt } from '../lib/texte';

const { etat, membre, nonLues } = Astro.locals;
const chemin = Astro.url.pathname;
const retour = adresseRetour(Astro.url);
const pageCompte = [ROUTES.accueil, ROUTES.connexion, ROUTES.inscription].includes(chemin as never);
const versConnexion = pageCompte ? ROUTES.connexion : `${ROUTES.connexion}?retour=${retour}`;
const versInscription = pageCompte ? ROUTES.inscription : `${ROUTES.inscription}?retour=${retour}`;
const niveau = NIVEAUX.find((n) => n.code === etat.niveau) ?? NIVEAUX[0];
const ROLES = { membre: 'Membre', moderateur: 'Modérateur', admin: 'Administrateur' } as const;
const estMembre = etat.session === 'membre' && membre;
---

<header class="site-header" data-header>
  <div class="scroll-progress" aria-hidden="true">
    <span data-scroll-progress></span>
  </div>
  <div class="container header-bar">
    <a class="brand" href={ROUTES.accueil} aria-label="Vysora, accueil">
      <img src="/assets/logos/vysora%20Bleu-Black.png" alt="" width="337" height="122" />
    </a>
    <nav class="main-nav" aria-label="Navigation principale">
      <ul>
        {NAVIGATION.map((e) => (
          <li>
            <a href={e.href} aria-current={e.actif(chemin) ? 'page' : undefined}>
              {e.libelle}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <button
        class="icon-btn"
        type="button"
        aria-label="Rechercher sur Vysora"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-keyshortcuts="Control+K Meta+K"
        data-recherche-ouvrir
      >
        <svg class="icon" aria-hidden="true">
          <use href="#i-search"></use>
        </svg>
      </button>
      <a class="btn btn-quiet btn-sm header-publish" href={ROUTES.publier}>
        <svg class="icon icon-sm" aria-hidden="true">
          <use href="#i-plus"></use>
        </svg>
        <span>Publier</span>
      </a>
      <span class="header-sep" aria-hidden="true"></span>
      <a class="btn btn-quiet btn-sm header-login" href={versConnexion} data-pour="visiteur">
        Se connecter
      </a>
      <a class="btn btn-primary btn-sm" href={versInscription} data-pour="visiteur">
        S’inscrire
      </a>
      {estMembre && (
        <div class="compte" data-pour="membre">
          <a
            class="icon-btn compte-notifs"
            href={ROUTES.notifications}
            data-compte-notifs
            aria-label={nonLues ? `Notifications, ${nonLues} non lues` : 'Notifications'}
          >
            <svg class="icon" aria-hidden="true">
              <use href="#i-bell"></use>
            </svg>
            <span class="compte-pastille" data-compte-nb>
              {nonLues ? String(nonLues) : ''}
            </span>
          </a>
          <button
            class:list={['compte-btn', { 'has-unread': nonLues > 0 }]}
            type="button"
            aria-expanded="false"
            aria-controls="compte-menu"
            data-compte-btn
          >
            {membre.avatar ? (
              <img
                class="avatar compte-avatar"
                src={membre.avatar}
                alt=""
                width="34"
                height="34"
                style="width:34px;height:34px"
                decoding="async"
              />
            ) : (
              <span class="avatar compte-avatar" style="width:34px;height:34px" aria-hidden="true">
                <svg class="icon" aria-hidden="true">
                  <use href="#i-user"></use>
                </svg>
              </span>
            )}
            <span class="sr-only">Votre compte</span>
          </button>
          <div class="compte-menu" id="compte-menu" hidden data-compte-menu>
            <div class="compte-qui">
              {membre.avatar ? (
                <img
                  class="avatar compte-avatar"
                  src={membre.avatar}
                  alt=""
                  width="40"
                  height="40"
                  style="width:40px;height:40px"
                  decoding="async"
                />
              ) : (
                <span
                  class="avatar compte-avatar"
                  style="width:40px;height:40px"
                  aria-hidden="true"
                >
                  <svg class="icon" aria-hidden="true">
                    <use href="#i-user"></use>
                  </svg>
                </span>
              )}
              <p>
                <b>{membre.pseudo}</b>
                <span>{`${niveau?.libelle} · ${fmt(membre.points)} points`}</span>
                {etat.role !== 'membre' && <em>{ROLES[etat.role]}</em>}
              </p>
            </div>
            <ul class="compte-liens">
              <li>
                <a href={ROUTES.profil(membre.pseudo)}>
                  <svg class="icon icon-sm" aria-hidden="true">
                    <use href="#i-user"></use>
                  </svg>
                  Mon profil
                </a>
              </li>
              <li>
                <a href={ROUTES.mesContenus}>
                  <svg class="icon icon-sm" aria-hidden="true">
                    <use href="#i-folder"></use>
                  </svg>
                  Mes contenus
                </a>
              </li>
              <li>
                <a href={ROUTES.notifications}>
                  <svg class="icon icon-sm" aria-hidden="true">
                    <use href="#i-bell"></use>
                  </svg>
                  Notifications
                  {nonLues > 0 && (
                    <span class="compte-nb" aria-label={`${nonLues} non lues`}>
                      {nonLues}
                    </span>
                  )}
                </a>
              </li>
              <li>
                <a href={ROUTES.parametres}>
                  <svg class="icon icon-sm" aria-hidden="true">
                    <use href="#i-settings"></use>
                  </svg>
                  Paramètres
                </a>
              </li>
            </ul>
            {etat.role !== 'membre' && (
              <ul class="compte-liens">
                <li>
                  <a href={ROUTES.moderation}>
                    <svg class="icon icon-sm" aria-hidden="true">
                      <use href="#i-shield"></use>
                    </svg>
                    Modération
                  </a>
                </li>
                {etat.role === 'admin' && (
                  <li>
                    <a href={ROUTES.administration}>
                      <svg class="icon icon-sm" aria-hidden="true">
                        <use href="#i-panel"></use>
                      </svg>
                      Administration
                    </a>
                  </li>
                )}
              </ul>
            )}
            <div class="compte-fin">
              <button class="compte-sortir" type="button" data-deconnexion>
                <svg class="icon icon-sm" aria-hidden="true">
                  <use href="#i-logout"></use>
                </svg>
                Se déconnecter
              </button>
            </div>
          </div>
        </div>
      )}
      <button
        class="icon-btn menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-panel"
        aria-label="Ouvrir le menu"
      >
        <svg class="icon" aria-hidden="true">
          <use href="#i-menu"></use>
        </svg>
      </button>
    </div>
  </div>
  <div class="mobile-panel" id="mobile-panel" hidden>
    <nav class="container" aria-label="Navigation mobile">
      <ul class="mobile-links">
        {NAVIGATION.map((e) => (
          <li>
            <a href={e.href} aria-current={e.actif(chemin) ? 'page' : undefined}>
              {e.libelle}
            </a>
          </li>
        ))}
        <li>
          <a
            href={ROUTES.publier}
            aria-current={chemin.startsWith(ROUTES.publier) ? 'page' : undefined}
          >
            Publier une création
          </a>
        </li>
      </ul>
      <div class="mobile-actions" data-pour="visiteur">
        <a class="btn btn-primary" href={versInscription}>
          S’inscrire
        </a>
        <a class="btn btn-secondary" href={versConnexion}>
          Se connecter
        </a>
      </div>
    </nav>
  </div>
</header>
