---
/* Apprendre (APP-02), porté de prototype/apprendre.html : barre locale des rubriques, recherche,
   lien « Ma progression » et zone des vues, que le script rend (scripts/apprendre.ts) à partir des
   contenus éditoriaux et des cas Bon réflexe de l'API, posés ici en JSON (#ap-donnees), avec la
   progression du membre sur les savoirs (APP-03). La vue d'ensemble, les rubriques, la page d'un
   savoir et celle d'un cas arrivent rendues par le serveur (référencement), avec les fonctions de
   lib/apprendre/pages.ts et lib/apprendre/vues.ts que le script emploie ensuite : il reprend la main
   sur le même balisage. Seule la progression (personnelle, non indexée) attend le script ; l'ordre
   des astuces selon « Mes outils », gardés dans le navigateur, aussi. */
import {
  raisonRefus,
  type CasApi,
  type CasResumeApi,
  type ComplementsSavoirsApi,
  type GuidesApi,
  type ListeCasApi,
  type ListeSujetsApi,
  type ProgressionSavoirsApi,
  type ReferentielsApi,
} from '@vysora/shared';
import { appelerApi } from '../lib/api';
import {
  creerModele,
  creerPages,
  lireVue,
  progressionDuServeur,
  typographier,
} from '../lib/apprendre/pages';
import type { DonneesPageApprendre } from '../lib/apprendre/types';
import { creerVues, filtresDeDepart } from '../lib/apprendre/vues';
import { icone } from '../lib/explorer/elements';
import { ROUTES } from '../lib/navigation';

interface Props {
  /** Cas demandé par l'adresse /bon-reflexe/[id]-[slug]. */
  casOuvert?: number | null;
  /** Ce cas en entier, lu par la page (options, et correction après une réponse). */
  casComplet?: CasApi | null;
}

const { casOuvert = null, casComplet = null } = Astro.props;
const options = { requete: Astro.request };

/** Cas validés, vingt par page : les premières pages suffisent à la bêta (au plus cent cas). */
async function tousLesCas(): Promise<CasResumeApi[]> {
  const premiere = await appelerApi<ListeCasApi>('/api/v1/cas', options).catch(() => null);
  if (!premiere) return [];
  const suite = await Promise.all(
    Array.from({ length: Math.min(premiere.pages, 5) - 1 }, (_, i) =>
      appelerApi<ListeCasApi>(`/api/v1/cas?page=${i + 2}`, options).catch(() => null),
    ),
  );
  return [premiere, ...suite].flatMap((page) => page?.elements ?? []);
}

// La progression d'un membre qui peut contribuer est gardée dans son compte ; sinon dans le navigateur.
const enCompte = !raisonRefus('contribuer', Astro.locals.etat);
const [cas, referentiels, guides, sujets, progression, complements] = await Promise.all([
  tousLesCas(),
  appelerApi<ReferentielsApi>('/api/v1/referentiels', options).catch(() => null),
  appelerApi<GuidesApi>('/api/v1/guides', options).catch(() => null),
  appelerApi<ListeSujetsApi>('/api/v1/sujets', options).catch(() => null),
  enCompte
    ? appelerApi<ProgressionSavoirsApi>('/api/v1/moi/savoirs', options).catch(() => null)
    : null,
  appelerApi<ComplementsSavoirsApi>('/api/v1/savoirs/complements', options).catch(() => null),
]);

const donnees: DonneesPageApprendre = {
  cas,
  outils: (referentiels?.outils ?? []).map((o) => ({
    id: o.id,
    nom: o.nom,
    slug: o.slug,
    logo: o.logo,
    logoMonochrome: o.logoMonochrome,
    famille: o.famille,
  })),
  guides: (guides?.elements ?? []).map((g) => ({
    slug: g.slug,
    titre: g.titre,
    titreCourt: g.titreCourt,
  })),
  domaines: (referentiels?.categories ?? []).map((c) => ({
    libelle: c.libelle,
    slug: c.slug,
    icone: c.icone,
  })),
  casOuvert,
  casComplet,
  aujourdhui: new Date().toISOString().slice(0, 10),
  chiffres: { sujets: sujets?.total ?? 0, outils: referentiels?.outils.length ?? 0 },
  progression,
  complements,
};

// Référencement : les vues sont rendues ici, comme le script les rend.
const modele = creerModele(donnees);
const vue = lireVue(modele, Astro.url.searchParams);
const progres = progressionDuServeur(modele);
const pages = creerPages(modele, { progress: () => progres, today: donnees.aujourdhui });
const savoir = vue.view === 'savoir' ? modele.byId[vue.id] : undefined;
const casVu = vue.view === 'cas' ? modele.caseById[vue.id] : undefined;
// Une règle se met à l'épreuve d'un cas, la vue d'ensemble présente le cas du jour : il est lu ici et
// rendu avec ses options, puis le script le trouve dans les données de la page sans le redemander.
const situation = savoir
  ? modele.casDuPrototype(savoir.situation)
  : vue.view === 'accueil'
    ? modele.casDuJour
    : undefined;
if (situation && !situation.detail) {
  const complet = await appelerApi<CasApi>(`/api/v1/cas/${situation.id}`, options).catch(
    () => null,
  );
  if (complet) {
    donnees.casComplet = complet;
    situation.detail = complet;
    if (complet.correction) situation.correction = complet.correction;
  }
}
const vues = creerVues(modele, pages, filtresDeDepart(), {
  progress: () => progres,
  today: donnees.aujourdhui,
  mesOutils: () => [],
  peutProposer: () => !raisonRefus('proposer-cas', Astro.locals.etat),
});
const rendu = typographier(
  savoir
    ? pages.savoirHTML(savoir)
    : casVu
      ? pages.casHTML(casVu)
      : vue.view === 'accueil'
        ? vues.accueilHTML()
        : vue.view === 'rubrique'
          ? vues.RUBRIQUES[vue.rubrique]()
          : '',
);
---

<nav class="ap-local" aria-label="Rubriques d’Apprendre" data-ap-local>
  <div class="container ap-local-bar">
    <a
      class="ap-local-title"
      href={ROUTES.apprendre}
      data-ap-nav
      aria-current={vue.view === 'accueil' ? 'page' : undefined}
    >
      Apprendre
    </a>
    <ul
      class="ap-local-tabs"
      data-ap-tabs
      set:html={typographier(vues.onglets(vue.view, vue.rubrique))}
    />
    <div class="ap-local-tools">
      <button
        class="ap-search-btn"
        type="button"
        aria-expanded="false"
        aria-controls="ap-search"
        data-ap-search-open
      >
        <Fragment set:html={icone('search')} />
        <span>Rechercher</span>
        <kbd aria-hidden="true">/</kbd>
      </button>
      <a
        class="ap-progress-link"
        href={`${ROUTES.apprendre}?vue=progression`}
        data-ap-nav
        data-ap-progress-link
        aria-current={vue.view === 'progression' ? 'page' : undefined}
        set:html={vues.lienProgression()}
      />
    </div>
  </div>
  <div class="ap-search" id="ap-search" hidden data-ap-search>
    <div class="container">
      <div class="ap-search-box">
        <label class="ap-search-field">
          <Fragment set:html={icone('search', '')} />
          <span class="sr-only">Rechercher une base, une notion, une règle ou une astuce</span>
          <input
            type="search"
            placeholder="Une notion, une règle, un outil…"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="ap-search-status"
            data-ap-search-input
          />
          <button
            class="icon-btn"
            type="button"
            aria-label="Fermer la recherche"
            data-ap-search-close
          >
            <Fragment set:html={icone('close', '')} />
          </button>
        </label>
        <p class="sr-only" id="ap-search-status" aria-live="polite" data-ap-search-status></p>
        <ul class="ap-search-results" data-ap-search-results></ul>
      </div>
    </div>
  </div>
</nav>
<div
  class="ap-view"
  data-ap-view
  data-ap-screen={rendu ? vue.view : undefined}
  data-ap-rendue={rendu ? '' : undefined}
  set:html={rendu}
/>

<dialog
  class="ex-dialog ex-tools"
  aria-labelledby="ex-tools-title"
  aria-describedby="ex-tools-desc"
  data-tools-dialog
>
  <form method="dialog" class="ex-tools-form">
    <div class="ex-dialog-head">
      <div>
        <h2 id="ex-tools-title">Mes outils</h2>
        <p id="ex-tools-desc">
          Sélectionnez les outils que vous utilisez. Les astuces de vos outils passent en premier.
        </p>
      </div>
      <button class="icon-btn" type="button" aria-label="Fermer" data-close-tools>
        <Fragment set:html={icone('close', '')} />
      </button>
    </div>
    <label class="ex-tools-search">
      <Fragment set:html={icone('search')} />
      <span class="sr-only">Rechercher un outil</span>
      <input type="search" placeholder="Rechercher un outil" autocomplete="off" data-tools-filter />
    </label>
    <div class="ex-tools-list" data-tools-list></div>
    <div class="ex-dialog-foot">
      <button class="link-btn" type="button" data-tools-reset>
        Effacer la sélection
      </button>
      <button class="btn btn-primary" type="submit" value="save" data-tools-save>
        Enregistrer
      </button>
    </div>
  </form>
</dialog>

<script type="application/json" id="ap-donnees" set:html={JSON.stringify(donnees)} />
<script>
  import '../scripts/apprendre';
</script>
