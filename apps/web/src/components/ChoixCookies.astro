---
/* LEG-03 : choix sur les cookies. Le bandeau, une barre discrète en bas de l'écran, s'affiche tant
   qu'aucun choix de la version en cours n'est retenu (cookie vysora_consentement) ; il ne bloque pas
   la page, et refuser y est aussi simple qu'accepter (deux boutons identiques). Le dialogue « Gérer
   les cookies » s'ouvre par « Personnaliser » et par le lien du pied de page. Écrans sans maquette
   dans le prototype : style du dialogue d'accès (etats.css). Branchés par scripts/commun/cookies.ts. */
import { choixCookiesAttendu } from '@vysora/shared';
import { ROUTES } from '../lib/navigation';
import { typo } from '../lib/texte';
import FinalitesCookies from './FinalitesCookies.astro';

const attendu = choixCookiesAttendu(Astro.request.headers.get('cookie'));
---

{attendu && (
  <section class="ck-bandeau" aria-label="Choix sur les cookies" data-ck-bandeau>
    <div class="container ck-bandeau-in">
      <p class="ck-bandeau-texte">
        {typo(
          'Nous utilisons des cookies indispensables et mesurons l’audience de façon anonyme. Avec votre accord, nous suivons aussi le parcours de vos visites pour améliorer Vysora.',
        )}{' '}
        <a href={ROUTES.cookies}>En savoir plus</a>
      </p>
      <div class="ck-bandeau-actions">
        <button class="ck-lien" type="button" data-ck-action="personnaliser">
          Personnaliser
        </button>
        <button class="btn btn-secondary btn-sm" type="button" data-ck-action="refuser">
          Tout refuser
        </button>
        <button class="btn btn-secondary btn-sm" type="button" data-ck-action="accepter">
          Tout accepter
        </button>
      </div>
    </div>
  </section>
)}

<dialog class="acces ck-dialogue" aria-labelledby="ck-dialogue-titre" data-ck-dialogue>
  <button class="icon-btn acces-fermer" type="button" aria-label="Fermer" data-ck-fermer>
    <svg class="icon" aria-hidden="true">
      <use href="#i-close"></use>
    </svg>
  </button>
  <h2 id="ck-dialogue-titre">Gérer les cookies</h2>
  <p class="ck-dialogue-intro">
    {typo('Choisissez ce que Vysora peut mesurer. Vous pourrez changer d’avis à tout moment.')}{' '}
    <a href={ROUTES.cookies}>En savoir plus</a>
  </p>
  <FinalitesCookies prefixe="ck-dialogue" />
  <div class="ck-dialogue-actions">
    <button class="btn btn-secondary btn-sm" type="button" data-ck-action="refuser">
      Tout refuser
    </button>
    <button class="btn btn-secondary btn-sm" type="button" data-ck-action="accepter">
      Tout accepter
    </button>
    <button class="btn btn-primary btn-sm" type="button" data-ck-action="enregistrer">
      Enregistrer
    </button>
  </div>
</dialog>
