---
/* LEG-03 : choix sur les cookies, sur le modèle des outils de consentement courants. Une fenêtre au
   centre de l'écran, page assombrie et figée derrière, en trois onglets : « Consentement » (le
   message), « Détails » (les catégories et leurs interrupteurs), « À propos des cookies ». Trois
   boutons de même taille : « Tout refuser », « Personnaliser » (ouvre « Détails », puis devient
   « Enregistrer mes choix ») et « Tout accepter ». La fenêtre s'ouvre tant qu'aucun choix de la
   version en cours n'est retenu (cookie vysora_consentement, `data-ck-attendu`) ; le lien « Gérer
   les cookies » du pied de page la rouvre sur « Détails », avec un bouton de fermeture. Démo dans le
   prototype : choix-cookies.js, dans le style des onglets et des cartes du site. Ouverte par
   scripts/commun/cookies.ts (showModal). */
import { choixCookiesAttendu } from '@vysora/shared';
import { ROUTES } from '../lib/navigation';
import { typo } from '../lib/texte';
import FinalitesCookies from './FinalitesCookies.astro';

// La fenêtre bloque la page : elle ne s'ouvre pas d'elle-même sur les deux pages vers lesquelles
// elle renvoie, qui doivent rester lisibles (la page Cookies a ses propres réglages).
const PAGES_LUES: string[] = [ROUTES.cookies, ROUTES.confidentialite];
const pageLue = PAGES_LUES.includes(Astro.url.pathname.replace(/\/+$/, ''));
const attendu = choixCookiesAttendu(Astro.request.headers.get('cookie')) && !pageLue;
const ONGLETS = [
  { cle: 'consentement', libelle: 'Consentement' },
  { cle: 'details', libelle: 'Détails' },
  { cle: 'apropos', libelle: 'À propos', complement: ' des cookies' },
] as const;
---

<dialog
  class="ck-panneau"
  aria-labelledby="ck-titre"
  data-ck-panneau
  data-ck-vue="consentement"
  data-ck-attendu={attendu ? '' : undefined}
>
  <div class="ck-marque">
    <img
      class="ck-logo"
      src="/assets/logos/vysora%20Bleu-Black.png"
      alt="Vysora"
      width="337"
      height="122"
      loading="lazy"
    />
    <button class="icon-btn ck-fermer" type="button" aria-label="Fermer" data-ck-fermer hidden>
      <svg class="icon" aria-hidden="true">
        <use href="#i-close"></use>
      </svg>
    </button>
  </div>

  <div class="ck-onglets" role="tablist" aria-label="Choix sur les cookies">
    {ONGLETS.map((onglet, i) => (
      <button
        type="button"
        role="tab"
        id={`ck-onglet-${onglet.cle}`}
        aria-controls={`ck-vue-${onglet.cle}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-ck-onglet={onglet.cle}
      >
        {typo(onglet.libelle)}
        {'complement' in onglet && <span class="ck-complement">{onglet.complement}</span>}
      </button>
    ))}
  </div>

  <div class="ck-vues">
    <div
      class="ck-vue ck-vue-message"
      id="ck-vue-consentement"
      role="tabpanel"
      aria-labelledby="ck-onglet-consentement"
    >
      <span class="ck-vue-icone" aria-hidden="true">
        <svg class="icon">
          <use href="#i-shield"></use>
        </svg>
      </span>
      <div>
        <h2 class="ck-titre" id="ck-titre">
          Ce site utilise des cookies
        </h2>
        <p>
          {typo(
            'Nous utilisons des cookies pour faire fonctionner Vysora, mesurer son audience de façon anonyme et, avec votre accord, comprendre le parcours de vos visites afin d’améliorer le site. Vous pouvez changer d’avis à tout moment avec le lien « Gérer les cookies », en bas de chaque page.',
          )}
        </p>
      </div>
    </div>
    <div
      class="ck-vue"
      id="ck-vue-details"
      role="tabpanel"
      aria-labelledby="ck-onglet-details"
      hidden
    >
      <FinalitesCookies prefixe="ck-panneau" />
    </div>
    <div
      class="ck-vue ck-vue-message"
      id="ck-vue-apropos"
      role="tabpanel"
      aria-labelledby="ck-onglet-apropos"
      hidden
    >
      <span class="ck-vue-icone" aria-hidden="true">
        <svg class="icon">
          <use href="#i-doc"></use>
        </svg>
      </span>
      <div>
        <p>
          {typo(
            'Un cookie est un petit fichier enregistré par votre navigateur. Certains sont indispensables : ils gardent votre connexion et retiennent vos choix. Les autres ne sont déposés qu’avec votre accord. Vysora ne dépose aucun cookie publicitaire et ne confie rien à des tiers.',
          )}
        </p>
        <p class="ck-liens">
          <a href={ROUTES.cookies}>Politique relative aux cookies</a>
          <a href={ROUTES.confidentialite}>Politique de confidentialité</a>
        </p>
      </div>
    </div>
  </div>

  <div class="ck-panneau-actions">
    <button class="btn btn-secondary" type="button" data-ck-action="refuser">
      Tout refuser
    </button>
    <button class="btn btn-secondary ck-personnaliser" type="button" data-ck-action="personnaliser">
      <span data-ck-libelle>Personnaliser</span>
      <svg class="icon icon-sm ck-chevron" aria-hidden="true">
        <use href="#i-chevron-right"></use>
      </svg>
    </button>
    <button class="btn btn-primary" type="button" data-ck-action="accepter">
      Tout accepter
    </button>
  </div>
</dialog>
