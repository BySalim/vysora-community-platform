# Copier en infra/production/.env sur le serveur, puis remplacer chaque valeur. Ce fichier ne contient
# aucun secret réel ; le .env du serveur ne se commite jamais. Procédure : docs/deploiement.md.

# Nom de domaine public (sans https://), pointé vers l'adresse IP du serveur (enregistrements A/AAAA).
DOMAINE=vysora.example
# Adresse prévenue par Let's Encrypt en cas de problème de certificat.
EMAIL_CERTIFICATS=equipe@vysora.example

# « preproduction » autorise les données de démonstration (pnpm db:demo) ; « production » les refuse.
ENVIRONNEMENT=preproduction
# Préproduction : mot de passe des comptes de démonstration (<pseudo>@example.test), propre au serveur,
# 16 caractères au moins. Celui du dépôt est public et refusé ici.
MOT_DE_PASSE_DEMO=a-generer
LOG_LEVEL=info

# Mot de passe de PostgreSQL : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_MOT_DE_PASSE=a-generer

# Secrets de l'API, 32 octets chacun :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SEL_EMPREINTES=a-generer
CLE_CHIFFREMENT=a-generer

# E-mails : service transactionnel européen (ADR-0008), par exemple smtps://identifiant:secret@smtp.fournisseur.example:465
SMTP_URL=smtps://identifiant:secret@smtp.fournisseur.example:465
EMAIL_EXPEDITEUR="Vysora <ne-pas-repondre@vysora.example>"
EMAIL_EQUIPE=equipe@vysora.example

VERIFIER_FUITES=true
# Bêta fermée (INV-01) : l'inscription exige un code d'invitation.
INSCRIPTION_SUR_INVITATION=true
