# Serveur frontal de Vysora (OPS-01, ADR-0008) : certificat HTTPS obtenu et renouvelé par Caddy,
# /api envoyé directement à l'API (adresse du visiteur dans X-Forwarded-For), le reste au site.
{
	email {$EMAIL_CERTIFICATS}
}

{$DOMAINE} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Les images téléversées (/api/v1/fichiers/*) portent déjà leur en-tête de cache, posé par l'API.
	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:4321
	}

	# Journal des accès (pages, navigateurs, erreurs) sans donnée personnelle, comme l'annonce la
	# politique de confidentialité : adresse IP tronquée (IPv4 /16, IPv6 /32), jetons des liens
	# envoyés par e-mail et de la connexion avec GitHub ou Google remplacés. Cookies et en-tête
	# d'autorisation sont déjà masqués par Caddy.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>remote_ip ip_mask {
					ipv4 16
					ipv6 32
				}
				request>client_ip ip_mask {
					ipv4 16
					ipv6 32
				}
				request>uri query {
					replace jeton masque
					replace verifier masque
					replace email masque
					replace code masque
					replace state masque
				}
			}
		}
	}
}
